 {
  "id": "D08_B57A",
  "jp": "ようこそサイランドへ！\nわたしは　みなこョ\nここで　インストラクターをやっているの\nここのゲームは　サイパワーがひつようなのよ\nまけると　バイブレーションが　さがってしまうわ\nだから　プレイのやりすぎは　きんもつよ\nプレイしたいゲームを　えらんでね\n\n\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 127
 },
 {
  "id": "D08_B5FA",
