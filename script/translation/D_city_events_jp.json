  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 28
 },
 {
  "id": "D08_B63B",
  "jp": "これは　ねんりきをつかうゲームよ\nキャラを　さきにゴールさせたほうがかちよ\nねんじながら　ボタンをおしてね\nゲームをするには　サイポイントがひつようよ\nかてば　サイポイントが　ばいになるわ\nさあ　わたしがおあいてするわ！\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 111
 },
 {
  "id": "D08_B6AB",
  "jp": "これは　とうしをつかったゲームなの。\nみなこ　が　さきにカードをふせてだすから\nあなたは　そのカードの　かずを　とうししてね！\nおおきな　かずのカードを　だしたほうが\nかちになるの。　ただし　5は1にまけるのよ。\nそれに　おなじかずのときは　あなたのまけよ！\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 130
 },
 {
  "id": "D08_B72E",
  "jp": "そして　3かい　さきに　かったほうが\nそのラウンドの　しょうりしゃになるわ！\nあなたが　かてば　ポイントは　ばいになるの！\nでも　ゲームをするには　それなりの　ポイントが\nひつようだけど　あなたは　だいじょうぶかな？\nじゃあ　わたしが　おあいてするわ…………\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 130
 },
 {
  "id": "D08_B7B1",
  "jp": "これは　よちをつかった　ゲームなの。\nじゅうじボタンをつかって　おんなのこのキャラを\nじょうげ　さゆうの　ゴールまで　うごかしてね！\nキャラを　うごかせるのは　かならずしも\nじゅうじボタンの　とおりとは　かぎらないわ。\nうごかせる　ほうこうを　よちしないとだめよ！\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 133
 },
 {
  "id": "D08_B837",
  "jp": "ゴールパネルに　かかれている\nすうじの　ばいすうが　ポイントにかけられて\nあなたの　ポイントに　かさんされるのよ！\nでも　ゲームをするには　ポイントが\nひつようだけど　あなたは　だいじょうぶかな？\nわたしが　おうえんしてるから　ガンバッテネ！\n",
  "called_from": [
   "Psi Land games"
  ],
  "jp_bytes": 122
 },
 {
  "id": "D08_B8B2",
