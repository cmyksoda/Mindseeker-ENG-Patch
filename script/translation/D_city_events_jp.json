 {
  "id": "D12_9482",
  "jp": "ここはサイキックシテイーです。\nあなたは　ここで　ちょうのうりょくの\nじっせん　トレーニングを　つむことになります。\nじぶんが　じっさいに　このせかいのなかに\nあたかも　はいりこんだかのように　イメージして\nトレーニングを　つむことが　たいせつです。\nあせらず　ゆったりしたきもちで　やりましょう。\nいままでと　おなじように　なにかをかんじたら\nフイールコマンドを　つかってみてください。\n",
  "called_from": [
   "Psychic City map / travel"
  ],
  "jp_bytes": 195
 },
 {
  "id": "D12_9546",
  "jp": "イベントに　せいこうすれば　ポイントが\nあがります。　また　ポイントが　いってい\nいじょうに　なると　サイレベルが　あがります。\nレベルが　あがれば　キヨタから\nちょうのうりょくにかんする　じょうほうを\nあなたは　きくことが　できるでしょう。\nそして　レベルが　さいだいち　まで\nあげることが　できたならば　いよいよ\nさいしゅうイベントに　ちょうせんです。\n",
  "called_from": [
   "Psychic City map / travel"
  ],
  "jp_bytes": 179
 },
 {
  "id": "D12_95FA",
  "jp": "さいしゅうイベントに　せいこうしたならば\n{NAME}さんは　エンデイングを　たいけんし\nしんの　エスパーと　なることでしょう！\nいまひかっている　ここが　センターです。\nいどうするには　じゅうじボタンを　つかって\nいどうさきを　えらび　Ａボタンをおします。\n",
